{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NexaFilesS3BucketObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::nexafiles-cloud-vault/*"
    },
    {
      "Sid": "NexaFilesS3BucketLocationAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::nexafiles-cloud-vault"
    }
  ]
}

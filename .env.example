# NexaFiles Environment Configuration
# Flask Configuration
SECRET_KEY=nexafiles-super-secret-key-change-in-production-2026
FLASK_ENV=development
DEBUG=True
PORT=5000

# Storage Mode: 's3' (for AWS S3 Cloud Storage) or 'local' (offline cloud emulation mode)
STORAGE_MODE=local

# AWS S3 Cloud Storage Credentials (Required when STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexafiles-cloud-vault

# Security Limits
MAX_CONTENT_LENGTH_MB=50
PRESIGNED_URL_EXPIRATION=900
